# Raw and intermediate data — never commit the dataset itself (16GB, and
# the working norms require raw data to stay untouched/outside version control).
data/raw/*
!data/raw/.gitkeep
!data/raw/README.md
data/interim/*
!data/interim/.gitkeep

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
*.egg-info/
.venv/
venv/

# OS / editor
.DS_Store
.vscode/
